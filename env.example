# --- Database (asyncpg driver required) ---
DATABASE_URL=postgresql+asyncpg://radar:radar@localhost:5432/radar

# --- GitHub (fine-grained token, public repositories, read-only) ---
GITHUB_TOKEN=

# --- LLM ---
# OpenAI: leave LLM_BASE_URL empty and use an OpenAI model name.
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1 and a model like openai/gpt-4.1-mini
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=

# --- Background sync (optional, defaults shown) ---
# Repos kept fresh by the scheduled sync, comma-separated. Others sync on demand via POST /sync.
# SYNC_REPOS=scikit-learn/scikit-learn,vllm-project/vllm
# SYNC_ENABLED=true
# SYNC_INTERVAL_MINUTES=30
# SYNC_POLL_SECONDS=5
# SYNC_LOOKBACK_WEEKS=12

# --- Optional ---
# LOG_LEVEL=INFO
# MAX_WINDOW_DAYS=182
# MAX_FORECAST_WEEKS=12
